{
  "name": "@vokaboka/ui",
  "version": "2.0.0",
  "private": true,
  "description": "Vokaboka design system: chunky candy-coloured kids' vocabulary UI, paper-doll figures and an illustrated house.",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./styles.css": "./dist/index.css" },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --outfile=dist/index.js && tsc -p tsconfig.json"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": { "esbuild": "0.23.1", "typescript": "5.6.3", "react": "18.3.1", "react-dom": "18.3.1", "@types/react": "18.3.12" }
}
